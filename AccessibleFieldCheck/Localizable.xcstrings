    },
    "criterion.modalAccessibility.guidance": {
      "comment": "Guidance for the modalAccessibility accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Modals and sheets are announced and can be dismissed accessibly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los modales y hojas se anuncian y se pueden cerrar de forma accesible."
