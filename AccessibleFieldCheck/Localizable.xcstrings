    "criterion.touchTargetSize.guidance": {
      "comment": "Guidance for the touchTargetSize accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Interactive controls have a practical tappable area of at least 44 pt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los controles interactivos tienen un área táctil práctica de al menos 44 pt."
          }
