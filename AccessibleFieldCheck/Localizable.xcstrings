    "criterion.colorContrast.title": {
      "comment": "Title for the colorContrast accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color contrast"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraste de color"
          }
        }
      }
    },
    "criterion.colorContrast.guidance": {
      "comment": "Guidance for the colorContrast accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text and meaningful elements contrast enough with the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto y los elementos significativos contrastan lo suficiente con el fondo."
          }
        }
      }
    },
    "criterion.colorIndependentMeaning.title": {
      "comment": "Title for the colorIndependentMeaning accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color-independent meaning"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Significado independiente del color"
          }
        }
      }
    },
    "criterion.colorIndependentMeaning.guidance": {
      "comment": "Guidance for the colorIndependentMeaning accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meaning is not conveyed by color alone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El significado no se transmite solo con el color."
          }
        }
      }
    },
    "criterion.contentScaling.title": {
      "comment": "Title for the contentScaling accessibility criterion.",
