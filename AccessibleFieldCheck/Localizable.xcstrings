      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Animation respects Reduce Motion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las animaciones respetan Reducir movimiento."
          }
        }
