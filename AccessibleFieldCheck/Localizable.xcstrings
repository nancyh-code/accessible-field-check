    "criterion.contentScaling.guidance": {
      "comment": "Guidance for the contentScaling accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content is not clipped or lost at large text sizes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido no se recorta ni se pierde con tamaños de texto grandes."
          }
        }
      }
    },
    "criterion.dynamicType.title": {
