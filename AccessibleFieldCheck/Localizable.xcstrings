    "criterion.clearButtonLabels.guidance": {
      "comment": "Guidance for the clearButtonLabels accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons describe the action, not only an icon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los botones describen la acción, no solo un icono."
          }
        }
