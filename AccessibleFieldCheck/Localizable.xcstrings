      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Errors are identified clearly and accessibly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los errores se identifican de forma clara y accesible."
          }
        }
      }
    },
