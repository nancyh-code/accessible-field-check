          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Etiquetas claras de botones"
          }
        }
      }
    },
    "criterion.clearButtonLabels.guidance": {
      "comment": "Guidance for the clearButtonLabels accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Buttons describe the action, not only an icon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los botones describen la acción, no solo un icono."
          }
        }
      }
    },
    "criterion.colorContrast.title": {
      "comment": "Title for the colorContrast accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color contrast"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraste de color"
          }
        }
      }
    },
    "criterion.colorContrast.guidance": {
      "comment": "Guidance for the colorContrast accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text and meaningful elements contrast enough with the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto y los elementos significativos contrastan lo suficiente con el fondo."
          }
        }
      }
    },
    "criterion.colorIndependentMeaning.title": {
      "comment": "Title for the colorIndependentMeaning accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Color-independent meaning"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Significado independiente del color"
          }
        }
      }
    },
    "criterion.colorIndependentMeaning.guidance": {
      "comment": "Guidance for the colorIndependentMeaning accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meaning is not conveyed by color alone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El significado no se transmite solo con el color."
          }
        }
      }
    },
    "criterion.contentScaling.title": {
      "comment": "Title for the contentScaling accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content scaling"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escalado de contenido"
          }
        }
      }
    },
    "criterion.contentScaling.guidance": {
      "comment": "Guidance for the contentScaling accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Content is not clipped or lost at large text sizes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenido no se recorta ni se pierde con tamaños de texto grandes."
          }
        }
      }
    },
    "criterion.dynamicType.title": {
      "comment": "Title for the dynamicType accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dynamic Type"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto dinámico"
          }
        }
      }
    },
    "criterion.dynamicType.guidance": {
      "comment": "Guidance for the dynamicType accessibility criterion.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Text adapts to system accessibility text sizes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto se adapta a los tamaños de accesibilidad del sistema."
          }
        }
      }
    },
    "criterion.errorIdentification.title": {
